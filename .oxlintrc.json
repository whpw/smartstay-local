{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["**/dist/**", "dist-release/**", "**/build/**"],
  "overrides": [
    {
      "files": ["frontend/**/*.{ts,tsx}"],
      "env": {
        "browser": true
      }
    },
    {
      "files": ["backend/**/*.{ts,js}"],
      "env": {
        "node": true
      },
      "plugins": ["typescript", "unicorn", "oxc"]
    }
  ]
}
