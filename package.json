{
  "name": "smartstay-local",
  "version": "1.0.14",
  "private": true,
  "author": "Piotr Walczyszyn <piotr.walczyszyn@gmail.com>",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:mock": "bash scripts/dev-with-mocks.sh",
    "typecheck": "pnpm -F frontend -F backend -r typecheck",
    "build": "pnpm -F frontend -F backend -r build",
    "start": "pnpm -F backend -r start",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "ncu": "ncu -w -u",
    "prepare": "husky"
  },
  "dependencies": {
    "@types/node": "^26.2.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
