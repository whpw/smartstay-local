[Unit]
Description=SmartStay.app Service
After=network.target

[Service]
Type=simple
User=smartstay
WorkingDirectory=/home/smartstay/smartstay-local/current/backend
Environment=NODE_ENV=production
Environment=DEBUG=*,-*:debug
Environment=APPDATA_DIR=/home/smartstay/appdata
Environment=INSTALL_ROOT=/home/smartstay/smartstay-local/current
Environment=SMARTSTAY_HOME=/home/smartstay/smartstay-local
# Only kill the main PID so a detached OTA apply-update.sh can finish.
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=20
# Clear a leftover listener from older npm/pnpm wrapper layouts.
ExecStartPre=-/bin/bash -c '/usr/bin/fuser -k 8080/tcp >/dev/null 2>&1 || true; sleep 1'
# Block systemd Restart= while OTA holds appdata/ota.lock (replaces start.sh wait).
ExecStartPre=/bin/bash /home/smartstay/smartstay-local/current/scripts/wait-ota-lock.sh
ExecStart=/usr/local/bin/node /home/smartstay/smartstay-local/current/backend/dist/index.js
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
